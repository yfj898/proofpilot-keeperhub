# KeeperHub organization API key. Create under Settings -> API Keys -> Organisation.
# Never commit the real value.
KH_API_KEY=kh_replace_me

# Base Sepolia only for the hackathon MVP.
PROOFPILOT_CHAIN_ID=84532

# A Base Sepolia recipient address you control or are allowed to use.
# Do not use a mainnet address for the Gate 0 test.
PROOFPILOT_RECIPIENT=0x0000000000000000000000000000000000000000

# Tiny TESTNET-only native ETH amount for the broadcast gate.
PROOFPILOT_AMOUNT=0.000001

# External red-team provider. Keep the real key in ignored .env only.
GUARDIAN_LLM_API_KEY=replace_with_nvidia_integrate_api_key
GUARDIAN_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
